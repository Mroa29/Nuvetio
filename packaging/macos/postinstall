#!/bin/bash

set -eu

TARGET_VOLUME="${2:-/}"
PACKAGE_ROOT="$TARGET_VOLUME/Users/Shared/Nuvetio"
CONSOLE_USER="$(stat -f '%Su' /dev/console)"

if [ "$CONSOLE_USER" = "root" ] || [ -z "$CONSOLE_USER" ]; then
  echo "No se pudo identificar al usuario activo; Nuvetio quedó copiado y se activará al abrir Codex o Claude Code." >&2
  exit 0
fi

CODEX="$(su -l "$CONSOLE_USER" -c 'command -v codex' 2>/dev/null || true)"
if [ -z "$CODEX" ]; then
  if su -l "$CONSOLE_USER" -c 'command -v claude' >/dev/null 2>&1; then
    echo "Claude Code detectado; consulta la guía para activar el adaptador de Nuvetio."
  else
    echo "Codex CLI no está instalado; Nuvetio quedó copiado y puede activarse después en Codex Desktop, Codex CLI o Claude Code."
  fi
  exit 0
fi

su -l "$CONSOLE_USER" -c "\"$CODEX\" plugin marketplace add \"$PACKAGE_ROOT\""
su -l "$CONSOLE_USER" -c "\"$CODEX\" plugin add 'nuvetio@nuvetio'"

if command -v osascript >/dev/null 2>&1; then
  su -l "$CONSOLE_USER" -c "osascript -e 'display dialog \"Nuvetio quedó instalado en Codex. Abre una sesión nueva para comenzar.\" buttons {\"Aceptar\"} default button \"Aceptar\"'" || true
fi
